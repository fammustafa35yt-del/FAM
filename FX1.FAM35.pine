//@version=6
// ===================================================================
//  FX1.FAM35 — Gold (XAU) Elliott-Wave Signal Indicator for TradingView
//  Pine Script v6
//
//  Port of the FX1.FAM35 MetaTrader 5 EA logic to a TradingView indicator:
//   - Elliott-Wave style swing/pivot structure + EMA / ADX / RSI trend
//   - Fast trend detection + higher-TF bias for swing
//   - Scalp / Swing / Both  (personal control)
//   - Buy / Sell / Both     (personal control)
//   - 1:3 Risk/Reward with staged targets (1R / 2R / 3R)
//   - SL placed behind the pullback pivot (+ ATR buffer)
//   - Multi-confluence "studied" entries (no random signals)
//   - On-chart dashboard: status, trend, signals, wins, losses, win-rate
//   - Buy/Sell alerts (connectable to a broker webhook for execution)
//
//  NOTE: A TradingView indicator analyses & alerts — it does NOT place
//        broker orders by itself. Use the alerts (-> webhook) for auto
//        execution, or use the MT5 .mq5 version for real order management
//        (partial closes, trailing SL, money management).
// ===================================================================
indicator("FX1.FAM35 — Gold Wave Signals", shorttitle="FX1.FAM35", overlay=true, max_lines_count=500, max_labels_count=500)

// ===================== Personal Control =====================
styleMode = input.string("Both", "Style / الستايل", options=["Scalp","Swing","Both"], group="Personal Control / تحكم شخصي")
dirMode   = input.string("Both", "Direction / الاتجاه", options=["Buy","Sell","Both"], group="Personal Control / تحكم شخصي")

// ===================== Targets (1:3) =====================
rr   = input.float(3.0, "Reward:Risk — final TP (xR)", step=0.1, minval=0.5, group="Targets / الأهداف")
tp1R = input.float(1.0, "TP1 (xR)", step=0.1, minval=0.1, group="Targets / الأهداف")
tp2R = input.float(2.0, "TP2 (xR)", step=0.1, minval=0.1, group="Targets / الأهداف")

// ===================== Strategy / Wave Engine =====================
fastLen  = input.int(21,  "Fast EMA", minval=1, group="Engine / المحرك")
slowLen  = input.int(50,  "Slow EMA", minval=1, group="Engine / المحرك")
trendLen = input.int(200, "Trend EMA", minval=1, group="Engine / المحرك")
adxLen   = input.int(14,  "ADX / DMI length", minval=1, group="Engine / المحرك")
adxMinSc = input.float(18.0, "ADX min (Scalp)", group="Engine / المحرك")
adxMinSw = input.float(22.0, "ADX min (Swing)", group="Engine / المحرك")
rsiLen   = input.int(14,  "RSI length", minval=1, group="Engine / المحرك")
atrLen   = input.int(14,  "ATR length", minval=1, group="Engine / المحرك")
pvLeft   = input.int(3,   "Pivot left", minval=1, group="Engine / المحرك")
pvRight  = input.int(3,   "Pivot right", minval=1, group="Engine / المحرك")
maxPB    = input.int(25,  "Max bars since pullback pivot", minval=1, group="Engine / المحرك")
slBuf    = input.float(0.5, "SL buffer (xATR)", step=0.1, group="Engine / المحرك")
maxRiskATR = input.float(6.0, "Reject signal if R > xATR", step=0.5, group="Engine / المحرك")
swingTF  = input.timeframe("240", "Higher TF for swing bias", group="Engine / المحرك")

// ===================== Visuals =====================
showEMA   = input.bool(true, "Show EMAs", group="Visuals / العرض")
showLvls  = input.bool(true, "Show SL / TP levels", group="Visuals / العرض")
lineLen   = input.int(30, "Level line length (bars)", minval=1, group="Visuals / العرض")
showPanel = input.bool(true, "Show dashboard", group="Visuals / العرض")
tblPos    = input.string("Top Right", "Panel position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group="Visuals / العرض")

// ===================== Indicators =====================
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)
atr      = ta.atr(atrLen)
rsi      = ta.rsi(close, rsiLen)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)

// Higher timeframe bias (non-repainting)
htfEma   = request.security(syminfo.tickerid, swingTF, ta.ema(close, slowLen), lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, swingTF, close, lookahead=barmerge.lookahead_off)
htfUp    = not na(htfEma) and htfClose > htfEma
htfDn    = not na(htfEma) and htfClose < htfEma

// ===================== Trend detection =====================
trendUp  = emaFast > emaSlow and close > emaSlow and close >= emaTrend
trendDn  = emaFast < emaSlow and close < emaSlow and close <= emaTrend
trendDir = trendUp ? 1 : trendDn ? -1 : 0

// ===================== Wave / pivot structure =====================
ph = ta.pivothigh(high, pvLeft, pvRight)
pl = ta.pivotlow(low,  pvLeft, pvRight)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
var int   barsPH = na
var int   barsPL = na

if not na(ph)
    prevPH := lastPH
    lastPH := ph
    barsPH := pvRight
else
    barsPH := na(barsPH) ? na : barsPH + 1

if not na(pl)
    prevPL := lastPL
    lastPL := pl
    barsPL := pvRight
else
    barsPL := na(barsPL) ? na : barsPL + 1

structOK = not na(lastPH) and not na(prevPH) and not na(lastPL) and not na(prevPL)
waveUp   = structOK and lastPH > prevPH and lastPL > prevPL   // higher-high + higher-low
waveDn   = structOK and lastPH < prevPH and lastPL < prevPL   // lower-high + lower-low

// ===================== Permissions =====================
allowSwing = styleMode == "Swing" or styleMode == "Both"
allowScalp = styleMode == "Scalp" or styleMode == "Both"
allowBuy   = dirMode  == "Buy"  or dirMode  == "Both"
allowSell  = dirMode  == "Sell" or dirMode  == "Both"
freshPL    = not na(barsPL) and barsPL <= maxPB
freshPH    = not na(barsPH) and barsPH <= maxPB

// ===================== Entry conditions (studied confluence) =====================
// BUY: established uptrend, structure not bearish, momentum turning up (not overbought),
//      price holding above a fresh pullback low.
buyBase = trendUp and not waveDn and rsi > 50 and rsi < 78 and not na(lastPL) and close > lastPL and freshPL
buyScalpOK = allowScalp and buyBase and adx >= adxMinSc
buySwingOK = allowSwing and buyBase and adx >= adxMinSw and htfUp
buyCond = allowBuy and (buyScalpOK or buySwingOK)

// SELL: mirror image
sellBase = trendDn and not waveUp and rsi < 50 and rsi > 22 and not na(lastPH) and close < lastPH and freshPH
sellScalpOK = allowScalp and sellBase and adx >= adxMinSc
sellSwingOK = allowSwing and sellBase and adx >= adxMinSw and htfDn
sellCond = allowSell and (sellScalpOK or sellSwingOK)

// ===================== Risk / SL / R =====================
slBuyPrice  = not na(lastPL) ? lastPL - atr * slBuf : na
rBuy        = not na(slBuyPrice) ? close - slBuyPrice : na
buyRiskOK   = not na(rBuy) and rBuy > 0 and rBuy <= atr * maxRiskATR

slSellPrice = not na(lastPH) ? lastPH + atr * slBuf : na
rSell       = not na(slSellPrice) ? slSellPrice - close : na
sellRiskOK  = not na(rSell) and rSell > 0 and rSell <= atr * maxRiskATR

// ===================== Virtual trade tracker + statistics =====================
// One virtual position at a time. A signal is counted a WIN if TP1 (1R) is
// reached before SL (mirrors the EA: SL -> break-even after TP1), a LOSS if
// SL is hit first.
var int   vDir   = 0
var float vEntry = na
var float vSL    = na
var float vTP1   = na
var float vTP2   = na
var float vTP3   = na
var int   wins   = 0
var int   losses = 0
var int   totalSig = 0

// resolve the active virtual trade first
if vDir == 1
    if low <= vSL
        losses := losses + 1
        vDir := 0
    else if high >= vTP1
        wins := wins + 1
        vDir := 0
else if vDir == -1
    if high >= vSL
        losses := losses + 1
        vDir := 0
    else if low <= vTP1
        wins := wins + 1
        vDir := 0

// fire new signals only when no virtual trade is active
buyFire  = buyCond  and buyRiskOK  and vDir == 0
sellFire = sellCond and sellRiskOK and vDir == 0

if buyFire
    vDir   := 1
    vEntry := close
    vSL    := slBuyPrice
    vTP1   := close + rBuy * tp1R
    vTP2   := close + rBuy * tp2R
    vTP3   := close + rBuy * rr
    totalSig := totalSig + 1
    if showLvls
        line.new(bar_index, vSL,  bar_index + lineLen, vSL,  color=color.new(color.red,0),   width=2)
        line.new(bar_index, vTP1, bar_index + lineLen, vTP1, color=color.new(color.green,0),  style=line.style_dashed)
        line.new(bar_index, vTP2, bar_index + lineLen, vTP2, color=color.new(color.green,20), style=line.style_dashed)
        line.new(bar_index, vTP3, bar_index + lineLen, vTP3, color=color.new(color.green,0),  width=2)
    alert("FX1.FAM35 BUY " + syminfo.ticker + " entry=" + str.tostring(vEntry, format.mintick) + " SL=" + str.tostring(vSL, format.mintick) + " TP1=" + str.tostring(vTP1, format.mintick) + " TP2=" + str.tostring(vTP2, format.mintick) + " TP3=" + str.tostring(vTP3, format.mintick), alert.freq_once_per_bar_close)

if sellFire
    vDir   := -1
    vEntry := close
    vSL    := slSellPrice
    vTP1   := close - rSell * tp1R
    vTP2   := close - rSell * tp2R
    vTP3   := close - rSell * rr
    totalSig := totalSig + 1
    if showLvls
        line.new(bar_index, vSL,  bar_index + lineLen, vSL,  color=color.new(color.red,0),   width=2)
        line.new(bar_index, vTP1, bar_index + lineLen, vTP1, color=color.new(color.green,0),  style=line.style_dashed)
        line.new(bar_index, vTP2, bar_index + lineLen, vTP2, color=color.new(color.green,20), style=line.style_dashed)
        line.new(bar_index, vTP3, bar_index + lineLen, vTP3, color=color.new(color.green,0),  width=2)
    alert("FX1.FAM35 SELL " + syminfo.ticker + " entry=" + str.tostring(vEntry, format.mintick) + " SL=" + str.tostring(vSL, format.mintick) + " TP1=" + str.tostring(vTP1, format.mintick) + " TP2=" + str.tostring(vTP2, format.mintick) + " TP3=" + str.tostring(vTP3, format.mintick), alert.freq_once_per_bar_close)

// ===================== Plots =====================
plot(showEMA ? emaFast  : na, "EMA Fast",  color=color.new(color.aqua,0))
plot(showEMA ? emaSlow  : na, "EMA Slow",  color=color.new(color.orange,0))
plot(showEMA ? emaTrend : na, "EMA Trend", color=color.new(color.gray,0))

plotshape(buyFire,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.lime,0), textcolor=color.black, text="BUY",  size=size.small)
plotshape(sellFire, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.red,0),  textcolor=color.white, text="SELL", size=size.small)

// classic alertcondition entries (for the alert dialog)
alertcondition(buyFire,  title="FX1.FAM35 BUY",  message="FX1.FAM35 BUY signal on {{ticker}} @ {{close}}")
alertcondition(sellFire, title="FX1.FAM35 SELL", message="FX1.FAM35 SELL signal on {{ticker}} @ {{close}}")

// ===================== Dashboard =====================
posMap(s) =>
    switch s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

fmt(x) => na(x) ? "-" : str.tostring(x, format.mintick)

var table dash = table.new(posMap(tblPos), 2, 13, frame_color=color.new(color.gray,0), frame_width=1, border_color=color.new(color.gray,40), border_width=1)

if showPanel and barstate.islast
    trendTxt = trendDir == 1 ? "UP" : trendDir == -1 ? "DOWN" : "RANGE"
    trendCol = trendDir == 1 ? color.lime : trendDir == -1 ? color.red : color.silver
    htfTxt   = htfUp ? "UP" : htfDn ? "DOWN" : "RANGE"
    sigTxt   = vDir == 1 ? "BUY (active)" : vDir == -1 ? "SELL (active)" : buyFire ? "BUY" : sellFire ? "SELL" : "-"
    sigCol   = vDir == 1 or buyFire ? color.lime : vDir == -1 or sellFire ? color.red : color.silver
    decided  = wins + losses
    wr       = decided > 0 ? wins / decided * 100.0 : 0.0
    bg       = color.new(#12161f, 0)
    hcol     = color.new(#0a2850, 0)

    table.cell(dash, 0, 0, "FX1.FAM35",  text_color=color.yellow, bgcolor=hcol, text_size=size.normal)
    table.cell(dash, 1, 0, "GOLD",       text_color=color.yellow, bgcolor=hcol, text_size=size.normal)

    table.cell(dash, 0, 1, "Symbol/TF",  text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 1, syminfo.ticker + " " + timeframe.period, text_color=color.white, bgcolor=bg)

    table.cell(dash, 0, 2, "Style",      text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 2, styleMode,    text_color=color.aqua,   bgcolor=bg)

    table.cell(dash, 0, 3, "Direction",  text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 3, dirMode,      text_color=color.aqua,   bgcolor=bg)

    table.cell(dash, 0, 4, "Trend",      text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 4, trendTxt,     text_color=trendCol,     bgcolor=bg)

    table.cell(dash, 0, 5, "HTF Trend",  text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 5, htfTxt,       text_color=color.white,  bgcolor=bg)

    table.cell(dash, 0, 6, "Signal",     text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 6, sigTxt,       text_color=sigCol,       bgcolor=bg)

    table.cell(dash, 0, 7, "Entry",      text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 7, fmt(vEntry),  text_color=color.white,  bgcolor=bg)

    table.cell(dash, 0, 8, "Stop Loss",  text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 8, fmt(vSL),     text_color=color.red,    bgcolor=bg)

    table.cell(dash, 0, 9, "TP 1/2/3",   text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 9, fmt(vTP1) + " / " + fmt(vTP2) + " / " + fmt(vTP3), text_color=color.green, bgcolor=bg)

    table.cell(dash, 0, 10, "Signals",   text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 10, str.tostring(totalSig), text_color=color.white, bgcolor=bg)

    table.cell(dash, 0, 11, "Wins",      text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 11, str.tostring(wins) + "  (" + str.tostring(wr, "#.#") + "%)", text_color=color.lime, bgcolor=bg)

    table.cell(dash, 0, 12, "Losses",    text_color=color.silver, bgcolor=bg)
    table.cell(dash, 1, 12, str.tostring(losses), text_color=color.red, bgcolor=bg)
