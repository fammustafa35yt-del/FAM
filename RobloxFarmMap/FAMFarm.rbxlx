GameConfig.HousePlot = {
	Count = 6,       -- عدد أراضي البيوت
	Price = 600,     -- سعر الأرض مع البيت
	Size = 34,
}

-- ================= الوظائف =================
-- Wage     : الأجر
-- Cooldown : ثواني الانتظار بين كل عملية عمل
-- Hold     : مدة الضغط المطول على الزر (E)
GameConfig.Jobs = {
	{
		Id = "Farmer",
		DisplayName = "عامل مزرعة 👨‍🌾",
		Wage = 20,
		Cooldown = 6,
		Hold = 2,
	},
	{
		Id = "Builder",
		DisplayName = "عامل بناء 👷",
