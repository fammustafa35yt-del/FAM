# ==== Twilio (telephony provider that dials the customer's phone) ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567

# ==== Anthropic (the LLM that runs the conversation) ====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Public HTTPS base URL Twilio can reach to fetch TwiML / send webhooks.
# In local dev, run `ngrok http 8000` and paste the https URL it gives you.
PUBLIC_BASE_URL=https://your-public-domain.example.com

# Company identity read out to the customer at the start of every call.
COMPANY_NAME=شركتك

# Spoken language for TTS/STT (Twilio language codes), e.g. ar-SA, ar-EG, ar-AE, en-US
CALL_LANGUAGE=ar-SA
# Voice used for <Say> (Amazon Polly). Arabic neural voice:
TTS_VOICE=Polly.Zeina

# Allowed local calling window (24h, customer's local time is NOT auto-detected,
# configure per your compliance requirements).
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=20

# Where the SQLite database file is stored.
DATABASE_PATH=./data/calls.db
